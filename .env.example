# Token dari Vercel Blob Storage (Storage > Create Database > Blob di dashboard Vercel).
# Wajib diisi di production. Kalau kosong saat development, aplikasi otomatis
# fallback menyimpan data ke folder lokal ./.data (lihat lib/data-store.ts).
BLOB_READ_WRITE_TOKEN=

# String rahasia untuk menandatangani cookie sesi admin (JWT).
# Wajib diganti dengan string acak yang panjang & unik saat production.
# Contoh generate: node -e "console.log(crypto.randomBytes(48).toString('hex'))"
SESSION_SECRET=ganti-dengan-string-rahasia-yang-panjang-dan-acak

# Nomor WhatsApp admin tujuan, format internasional tanpa "+" atau "00".
NEXT_PUBLIC_WHATSAPP_NUMBER=6281333385899

# (Opsional) Password Owner saat SEED PERTAMA KALI, ketika data akun belum ada.
# Kalau dikosongkan, seed memakai "123" dan WAJIB segera diganti lewat tab
# "Kelola Akun" > "Ubah Password Admin". Mengubah nilai ini TIDAK mereset
# password admin yang sudah tersimpan.
ADMIN_DEFAULT_PASSWORD=

# (Opsional) Berapa detik hasil baca data boleh dilayani dari cache. Default 30.
# Makin besar = makin sedikit operasi Vercel Blob, tapi perubahan admin makin
# lambat terlihat di halaman publik. Jalur tulis selalu membaca data segar.
DATA_CACHE_TTL_SECONDS=30

# (Opsional) Set ke 1 untuk menyalakan log operasi Blob di production.
# Log ini hanya memuat key, ukuran, dan alasan — tidak pernah password/token.
BLOB_DEBUG=
